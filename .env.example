# Copy to .env and fill in. .env is gitignored - never commit real secrets.

# Claude (competition credits / Track 2 Claude Max). Used by the stage-6 LLM shortlist.
ANTHROPIC_API_KEY=

# Hugging Face token for weight downloads (some folding models).
HF_TOKEN=

# PyRosetta: FREE ACADEMIC license token from RosettaCommons (required by BindCraft and by
# pH fa_elec / pHDock scoring in the switch stage). Non-commercial only.
PYROSETTA_LICENSE_ACK=0

# AlphaFold3 weights are academic-request-only (non-commercial). Leave blank to skip AF3 and
# rely on Boltz-2 + Chai-1 (both fully open). Path to the AF3 params dir if granted.
AF3_WEIGHTS_DIR=

# Modal (optional overflow compute).
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# uplifting-biomolecular-modeling: persistent JIT compile cache (recommended to set).
MODEL_OPT_JIT_ROOT=
# Shared design-tool roots (see ./init.sh --tools). Set if you relocate them.
# RFD3_ROOT=/home/prachh/work/cache/rfdiffusion3_opt
# GENIE3_ROOT=/home/prachh/work/cache/genie3_opt
# BOLTZ2_WEIGHTS=~/.boltz
